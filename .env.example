POSTGRES_USER=dkh
POSTGRES_PASSWORD=change_me
POSTGRES_DB=devknowledgehub
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_too
NEO4J_URI=bolt://localhost:7687

# RAG : "hash" (dev/CI) ou "sentence-transformers"
# (pip install -r backend/requirements-ml.txt)
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

OLLAMA_BASE_URL=http://localhost:11434
# 1.5b : rapide sur CPU ; 7b : meilleure qualité mais lent sans GPU
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_TIMEOUT=300

# Ports d'exposition Docker (production uniquement)
BACKEND_PORT=8000
FRONTEND_PORT=8080

# URL d'Ollama vue depuis les conteneurs (production uniquement).
# host.docker.internal pointe vers la machine hôte sous Docker Desktop.
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
